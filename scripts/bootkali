#!/system/bin/sh
# Kali NetHunter Chroot Launcher for Fire HD 10 (suez)
#
# Mounts kernel virtual filesystems, shared storage, configures DNS,
# and drops into Kali Linux chroot or executes requested command.

CHROOT=/data/local/nhsystem/kali-armhf

if [ ! -d "$CHROOT" ]; then
    echo "[-] Error: Chroot directory $CHROOT does not exist!"
    exit 1
fi

# Ensure SELinux is permissive for chroot operation
setenforce 0 2>/dev/null || true

# Mount required virtual filesystems
grep -q "$CHROOT/proc " /proc/mounts || mount -t proc proc "$CHROOT/proc"
grep -q "$CHROOT/sys " /proc/mounts || mount -t sysfs sys "$CHROOT/sys"
grep -q "$CHROOT/dev " /proc/mounts || mount -o bind /dev "$CHROOT/dev"
grep -q "$CHROOT/dev/pts " /proc/mounts || mount -t devpts devpts "$CHROOT/dev/pts"

# Shared storage bind
mkdir -p "$CHROOT/sdcard" "$CHROOT/root/sdcard" 2>/dev/null
grep -q "$CHROOT/sdcard " /proc/mounts || mount -o bind /sdcard "$CHROOT/sdcard"

# DNS resolver configuration
mkdir -p "$CHROOT/etc" 2>/dev/null
echo "nameserver 1.1.1.1" > "$CHROOT/etc/resolv.conf"
echo "nameserver 8.8.8.8" >> "$CHROOT/etc/resolv.conf"
echo "127.0.0.1 localhost" > "$CHROOT/etc/hosts"

# Unset Android-specific LD_PRELOAD to prevent ld.so errors
unset LD_PRELOAD

# Clean environment paths
export PATH=/system/bin:/system/xbin:$PATH
CHROOT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Execute chroot
if [ $# -gt 0 ]; then
    /system/bin/chroot "$CHROOT" /usr/bin/env -i HOME=/root USER=root PATH="$CHROOT_PATH" TERM=xterm-256color "$@"
else
    /system/bin/chroot "$CHROOT" /usr/bin/env -i HOME=/root USER=root PATH="$CHROOT_PATH" TERM=xterm-256color /bin/bash -l
fi
